# 複製成 .env 後填入（.env 已列在 .gitignore，不會進版控）
# 填好後執行 npm run check-key 確認金鑰與模型可用（不會產生用量）

# AI 助理供應商：cursor（預設，用量算在 Cursor 方案）或 anthropic（Claude API，需另外儲值）
# 選定的供應商沒有金鑰時，自動改用示範回覆
AGENT_PROVIDER=cursor

# --- Cursor ---
# 金鑰：Cursor Dashboard（https://cursor.com/dashboard）→ API Keys
CURSOR_API_KEY=
# 可用模型 id 用 npm run check-key 查詢
# CURSOR_MODEL=composer-2.5

# --- Claude API（AGENT_PROVIDER=anthropic 時使用）---
# 金鑰：Claude Console（https://platform.claude.com）→ API Keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
